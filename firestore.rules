rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(shopUid, memberUid) {
      return /databases/$(database)/documents/shopMemberships/$(shopUid)/members/$(memberUid);
    }

    function isShopMember(shopUid) {
      return signedIn() && exists(memberPath(shopUid, request.auth.uid));
    }

    function isShopOwner(shopUid) {
      return signedIn()
        && exists(memberPath(shopUid, request.auth.uid))
        && get(memberPath(shopUid, request.auth.uid)).data.role == "owner";
    }

    // A pairing token is high-entropy and its SHA-256 hash is used as the document ID.
    // Only direct document reads are allowed; invite enumeration is denied.
    match /pairingInvites/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid is string
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.redeemed == false
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(11, 'm')
        && isShopOwner(request.resource.data.ownerUid);

      allow get: if signedIn()
        && resource.data.redeemed == false
        && resource.data.expiresAt > request.time;
      allow list: if false;

      // Redeem exactly once. The paired membership must be created in the same transaction.
      allow update: if signedIn()
        && resource.data.redeemed == false
        && request.resource.data.redeemed == true
        && request.resource.data.redeemedBy == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['redeemed', 'redeemedBy', 'redeemedAt']);
      allow delete: if false;
    }

    // Membership records are separate from shop data so members cannot grant access
    // by writing arbitrary documents under /shops.
    match /shopMemberships/{shopUid}/members/{memberUid} {
      allow get: if signedIn()
        && (request.auth.uid == shopUid || request.auth.uid == memberUid);
      allow list: if signedIn() && request.auth.uid == shopUid;

      // First device creates its own owner membership. A joining device must redeem
      // a valid invitation in the same atomic Firestore transaction.
      allow create: if signedIn()
        && request.auth.uid == memberUid
        && (
          (shopUid == request.auth.uid && request.resource.data.role == "owner")
          ||
          (
            request.resource.data.role == "member"
            && request.resource.data.inviteId is string
            && getAfter(
              /databases/$(database)/documents/pairingInvites/$(request.resource.data.inviteId)
            ).data.redeemed == true
            && getAfter(
              /databases/$(database)/documents/pairingInvites/$(request.resource.data.inviteId)
            ).data.redeemedBy == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/pairingInvites/$(request.resource.data.inviteId)
            ).data.ownerUid == shopUid
          )
        );

      // Only the shop owner can update or remove member records.
      allow update, delete: if signedIn() && request.auth.uid == shopUid;
    }

    // Staff profiles are separate from shop data. Paired devices may read profiles
    // to authenticate staff, but only the shop owner device may manage them.
    // Passwords are never stored in these documents.
    match /shopStaff/{shopUid}/accounts/{username} {
  allow get: if isShopMember(shopUid);
  allow list: if isShopOwner(shopUid);
  allow create, update, delete: if isShopOwner(shopUid);
   }

    // All inventory, sales, expenses, employee and settings documents are restricted
    // to devices that have an owner-created or successfully paired membership.
    match /shops/{shopUid}/{document=**} {
      allow read, write: if isShopMember(shopUid);
    }

    // Deny every other path by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
