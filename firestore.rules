rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each shop's cloud data is private to its Firebase owner account.
    match /shops/{ownerUid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == ownerUid;
    }

    // Deny all paths not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
